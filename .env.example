# Copy to .env and fill in. Never commit .env.
#
# IMPORTANT: single-quote any value containing # or $. Both django-environ and
# systemd's EnvironmentFile treat an unquoted # as the start of a comment, which
# silently truncates the value rather than failing.

# Required. Generate with:
#   uv run python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=''

# "true" only for local development.
DJANGO_DEBUG=false

# Comma-separated. Production omits www — nginx redirects it to the apex.
DJANGO_ALLOWED_HOSTS=nincatalog.com,merch.nincatalog.com,admin.nincatalog.com

# Application data, kept outside the deploy tree so deploys cannot destroy it.
DJANGO_DB_PATH=/srv/nincatalog/db.sqlite3
DJANGO_MEDIA_ROOT=/srv/nincatalog/media

# collectstatic output, inside the deploy tree.
DJANGO_STATIC_ROOT=/var/www/nincatalog/staticfiles

# Content-hashed static filenames. Defaults to "not DEBUG"; leave unset in
# production. manage.py forces it off for the test suite.
# DJANGO_STATIC_MANIFEST=true

CSRF_TRUSTED_ORIGINS=https://nincatalog.com,https://merch.nincatalog.com,https://admin.nincatalog.com

# MUST be 0 until the DNS cutover is complete. A non-zero value pins
# nincatalog.com in the tester's browser and then applies to the legacy
# production host once the /etc/hosts override is removed.
DJANGO_HSTS_SECONDS=0

# Gunicorn worker count. This host also runs nin.fan; keep this modest.
WEB_CONCURRENCY=3

DJANGO_LOG_LEVEL=INFO
